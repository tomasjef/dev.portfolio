{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dev-portfolio",
  "compatibility_date": "2026-10-06",
  // Only /projects/* (the videos and stills) goes through the Worker, for
  // range requests; everything else is the static export from `next build`
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/projects/*"]
  },
  "routes": [{ "pattern": "dev.tomasjef.com", "custom_domain": true }]
}
